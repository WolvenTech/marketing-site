{
  "name": "marketing-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "validate": "pnpm harness:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "harness:validate": "wolven-harness validate",
    "harness:comments": "wolven-harness comments",
    "harness:score": "harness-score"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm harness:comments && pnpm typecheck && pnpm format:check"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wolven-tech/harness": "^0.3.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "harness-score": "1.6.5",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
